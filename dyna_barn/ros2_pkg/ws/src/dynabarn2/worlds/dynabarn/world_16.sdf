        <target>robot</target>
        <namespace>robot</namespace>
        <time>0.001</time>
        <enabled>true</enabled>
      </plugin>
    </model>

    <model name="easylibobs_172">
      <pose>5.1300 -10.0000 0.5000 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>10.0</mass>
          <inertia><ixx>1.458333</ixx><iyy>1.458333</iyy><izz>1.250000</izz>
