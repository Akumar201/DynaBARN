      <plugin filename="DynaBarnObstacleMover" name="dynabarn2::ObstacleMover">
        <loop>true</loop>
        <interpolation>spline</interpolation>
        <waypoint>0.0000 5.1300 -10.0000 0.5000</waypoint>
