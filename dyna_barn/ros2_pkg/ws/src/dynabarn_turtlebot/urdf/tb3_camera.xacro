<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tb3_camera">

  <!-- Simple RGB camera mounted on top-front of the base -->
  <xacro:macro name="tb3_camera" params="parent:=base_link xyz:='0 0 0.18' rpy:='0 0 0'">

    <!-- Physical mount for TF -->
    <link name="camera_link">
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.03 0.03 0.02"/></geometry>
        <material name="Grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.03 0.03 0.02"/></geometry>
      </collision>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child  link="camera_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- Optical frame (REP 103): Z forward, X right, Y down -->
    <link name="camera_optical_frame"/>
    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child  link="camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    </joint>

    <!-- Gazebo camera sensor + ROS 2 bridge -->
    <gazebo reference="camera_link">
      <sensor name="rgb_cam" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.047</horizontal_fov> <!-- ~60 deg -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>10.0</far>
          </clip>
        </camera>

        <!-- Publishes /image_raw and /camera_info -->
        <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
          <ros>
            <!-- Optional namespace to keep topics under the model name -->
            <namespace>/tb3</namespace>
            <remapping>image:=image_raw</remapping>
            <remapping>camera_info:=camera_info</remapping>
          </ros>
          <frame_name>camera_optical_frame</frame_name>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>