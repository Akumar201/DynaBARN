<!-- Simplified TurtleBot3 Burger for MuJoCo (primitive geometry, no meshes).
     Dimensions and masses follow the TurtleBot3 Burger SDF. The root body is
     placed at the scenario start pose by the exporter. -->
<mujoco model="tb3_burger_cam">
  <default>
    <default class="tb3_wheel">
      <geom type="cylinder" size="0.033 0.009" zaxis="0 1 0" friction="1.2 0.005 0.0001"
            rgba="0.1 0.1 0.1 1" mass="0.0285"/>
      <joint type="hinge" axis="0 1 0" damping="0.0005" armature="0.0005"/>
    </default>
  </default>

  <worldbody>
    <body name="base_link" pos="0 0 0">
      <freejoint name="root"/>
      <geom name="chassis" type="box" size="0.07 0.07 0.065" pos="-0.032 0 0.08"
            rgba="0.25 0.25 0.25 1" mass="0.825"/>
      <geom name="lidar" type="cylinder" size="0.0508 0.0275" pos="-0.032 0 0.172"
            rgba="0.15 0.15 0.15 1" mass="0.114"/>
      <!-- Free-rolling ball caster. A fixed frictionless sphere here makes the
           chassis rock and bleeds ~0.6 W through the contact, so the ball
           gets its own ball joint, like the real Burger. -->
      <body name="caster_link" pos="-0.081 0 0.005">
        <joint name="caster_joint" type="ball" damping="1e-5"/>
        <geom name="caster" type="sphere" size="0.005" friction="1 0 0"
              rgba="0.5 0.5 0.5 1" mass="0.005"/>
      </body>
      <site name="base_scan" pos="-0.032 0 0.172" size="0.005"/>
      <camera name="rgb_cam" pos="0.04 0 0.18" xyaxes="0 -1 0 0 0 1" fovy="46.83"/>

      <body name="wheel_left_link" pos="0 0.08 0.033">
        <joint name="wheel_left_joint" class="tb3_wheel"/>
        <geom name="wheel_left" class="tb3_wheel"/>
      </body>
      <body name="wheel_right_link" pos="0 -0.08 0.033">
        <joint name="wheel_right_joint" class="tb3_wheel"/>
        <geom name="wheel_right" class="tb3_wheel"/>
      </body>
    </body>
  </worldbody>

  <!-- Wheel velocity servos. Torque is limited well below the tipping torque
       (~0.28 N m) so hard accelerations do not flip the robot. -->
  <actuator>
    <velocity name="wheel_left_vel" joint="wheel_left_joint" kv="0.05" ctrlrange="-7 7"
              forcerange="-0.1 0.1"/>
    <velocity name="wheel_right_vel" joint="wheel_right_joint" kv="0.05" ctrlrange="-7 7"
              forcerange="-0.1 0.1"/>
  </actuator>
</mujoco>
