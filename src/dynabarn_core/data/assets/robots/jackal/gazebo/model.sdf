<?xml version="1.0"?>
<!-- Simplified Clearpath Jackal for Gazebo (primitive geometry, no meshes),
     matching mujoco/robot.xml: body 0.42 x 0.31 x 0.184 m chassis, ~17 kg,
     4 driven wheels (skid steer), wheel radius 0.098 m, track 0.376 m,
     wheelbase 0.262 m. The model origin is on the ground under the chassis
     centre. Sensors and the drive plugin are added by the exporter from
     asset.yaml, so they match the MuJoCo robot. -->
<sdf version="1.9">
  <model name="jackal">
    <link name="base_link">
      <inertial>
        <pose>0 0 0.14 0 0 0</pose>
        <mass>16.43</mass>
        <inertia>
          <ixx>0.1733</ixx><iyy>0.2804</iyy><izz>0.3633</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="chassis">
        <pose>0 0 0.14 0 0 0</pose>
        <geometry><box><size>0.42 0.31 0.184</size></box></geometry>
      </collision>
      <visual name="chassis_visual">
        <pose>0 0 0.14 0 0 0</pose>
        <geometry><box><size>0.42 0.31 0.184</size></box></geometry>
        <material><ambient>0.85 0.65 0.05 1</ambient><diffuse>0.85 0.65 0.05 1</diffuse></material>
      </visual>
      <visual name="top_plate_visual">
        <pose>0 0 0.237 0 0 0</pose>
        <geometry><box><size>0.4 0.28 0.01</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="lidar_visual">
        <pose>0.12 0 0.26 0 0 0</pose>
        <geometry><cylinder><radius>0.03</radius><length>0.035</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <!-- wheels: cylinder axis along y (roll = pi/2) -->
    <link name="front_left_wheel_link">
      <pose>0.131 0.1877 0.098 0 0 0</pose>
      <inertial><mass>0.477</mass>
        <inertia><ixx>0.00121</ixx><iyy>0.00229</iyy><izz>0.00121</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.098</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.098</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <link name="rear_left_wheel_link">
      <pose>-0.131 0.1877 0.098 0 0 0</pose>
      <inertial><mass>0.477</mass>
        <inertia><ixx>0.00121</ixx><iyy>0.00229</iyy><izz>0.00121</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.098</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.098</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <link name="front_right_wheel_link">
      <pose>0.131 -0.1877 0.098 0 0 0</pose>
      <inertial><mass>0.477</mass>
        <inertia><ixx>0.00121</ixx><iyy>0.00229</iyy><izz>0.00121</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.098</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.098</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <link name="rear_right_wheel_link">
      <pose>-0.131 -0.1877 0.098 0 0 0</pose>
      <inertial><mass>0.477</mass>
        <inertia><ixx>0.00121</ixx><iyy>0.00229</iyy><izz>0.00121</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.098</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.098</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <joint name="front_left_wheel" type="revolute">
      <parent>base_link</parent><child>front_left_wheel_link</child>
      <axis><xyz>0 1 0</xyz><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>
    <joint name="rear_left_wheel" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel_link</child>
      <axis><xyz>0 1 0</xyz><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>
    <joint name="front_right_wheel" type="revolute">
      <parent>base_link</parent><child>front_right_wheel_link</child>
      <axis><xyz>0 1 0</xyz><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>
    <joint name="rear_right_wheel" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel_link</child>
      <axis><xyz>0 1 0</xyz><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>
  </model>
</sdf>
