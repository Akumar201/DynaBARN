<!-- Simplified Clearpath Jackal for MuJoCo (primitive geometry, no meshes).
     Body 0.508 x 0.430 x 0.250 m with wheels, ~17 kg, 4 driven wheels
     (skid steer), wheel radius 0.098 m, track 0.376 m, wheelbase 0.262 m.
     The root body origin is on the ground under the chassis centre. -->
<mujoco model="jackal">
  <default>
    <default class="jackal_wheel">
      <geom type="cylinder" size="0.098 0.02" zaxis="0 1 0" friction="0.9 0.005 0.0001"
            rgba="0.1 0.1 0.1 1" mass="0.477"/>
      <joint type="hinge" axis="0 1 0" damping="0.01" armature="0.01"/>
    </default>
  </default>

  <worldbody>
    <body name="base_link" pos="0 0 0">
      <freejoint name="root"/>
      <geom name="chassis" type="box" size="0.21 0.155 0.092" pos="0 0 0.14"
            rgba="0.85 0.65 0.05 1" mass="16.0"/>
      <geom name="top_plate" type="box" size="0.2 0.14 0.005" pos="0 0 0.237"
            rgba="0.15 0.15 0.15 1" mass="0.3"/>
      <geom name="lidar" type="cylinder" size="0.03 0.0175" pos="0.12 0 0.26"
            rgba="0.1 0.1 0.1 1" mass="0.13"/>
      <site name="base_scan" pos="0.12 0 0.27" size="0.01"/>
      <camera name="front_cam" pos="0.215 0 0.2" xyaxes="0 -1 0 0 0 1" fovy="46.83"/>

      <body name="front_left_wheel_link" pos="0.131 0.1877 0.098">
        <joint name="front_left_wheel" class="jackal_wheel"/>
        <geom name="front_left_wheel" class="jackal_wheel"/>
      </body>
      <body name="rear_left_wheel_link" pos="-0.131 0.1877 0.098">
        <joint name="rear_left_wheel" class="jackal_wheel"/>
        <geom name="rear_left_wheel" class="jackal_wheel"/>
      </body>
      <body name="front_right_wheel_link" pos="0.131 -0.1877 0.098">
        <joint name="front_right_wheel" class="jackal_wheel"/>
        <geom name="front_right_wheel" class="jackal_wheel"/>
      </body>
      <body name="rear_right_wheel_link" pos="-0.131 -0.1877 0.098">
        <joint name="rear_right_wheel" class="jackal_wheel"/>
        <geom name="rear_right_wheel" class="jackal_wheel"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="front_left_vel"  joint="front_left_wheel"  kv="30" ctrlrange="-21 21" forcerange="-25 25"/>
    <velocity name="rear_left_vel"   joint="rear_left_wheel"   kv="30" ctrlrange="-21 21" forcerange="-25 25"/>
    <velocity name="front_right_vel" joint="front_right_wheel" kv="30" ctrlrange="-21 21" forcerange="-25 25"/>
    <velocity name="rear_right_vel"  joint="rear_right_wheel"  kv="30" ctrlrange="-21 21" forcerange="-25 25"/>
  </actuator>
</mujoco>
